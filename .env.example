# 이 파일을 .env 로 복사한 뒤 값을 채움. .env 는 git 에 올리지 않음
DB_NAME=slotmate
DB_PORT=3306
DB_USERNAME=slotmate
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
# accessToken(JWT HS256) 서명 키. 32바이트 이상 (예: openssl rand -base64 48)
JWT_SECRET=change-me-at-least-32-bytes-long-secret
# 앱 기동 시 이 이메일 계정이 없으면 ADMIN 으로 생성. 비우면 생성 안 함
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 앱 기동 시 이 이메일 계정이 없으면 MEMBER(테스트 회원)로 생성. 비우면 생성 안 함
MEMBER_EMAIL=
MEMBER_PASSWORD=
